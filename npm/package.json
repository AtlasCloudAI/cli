{
  "name": "atlascloud-cli",
  "version": "0.1.36",
  "description": "AtlasCloud CLI for calling LLM, image, video, audio, and 3D APIs from terminals, scripts, and CI jobs.",
  "bin": {
    "atlas": "bin/atlas.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "files": [
    "bin/",
    "install.js",
    "README.md"
  ],
  "engines": {
    "node": ">=14"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "license": "MIT",
  "homepage": "https://atlascloud.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtlasCloudAI/cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "https-proxy-agent": "7.0.6",
    "proxy-from-env": "2.1.0"
  }
}
